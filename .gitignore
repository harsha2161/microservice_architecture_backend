# 1. Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# 2. Java / Spring Boot / Compiled Files
*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# 3. IntelliJ IDEA (IDE)
.idea/
*.iml
*.iws
*.ipr
out/

# 4. Eclipse / VS Code
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
.vscode/

# 5. OS Specific - Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# 6. OS Specific - Mac OS
.DS_Store
.AppleDouble
.LSOverride
._*

# 7. Environment Variables / Secrets
.env
.env.local
.env.*.local
application-secret.properties
application-secret.yml

# 8. Logs and Local Databases
logs/
*.sqlite
*.db